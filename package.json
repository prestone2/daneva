{
  "name": "daneva-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "node scripts/preview.mjs",
    "build:production": "tsc -b && node scripts/build.mjs --require-site-url",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "verify:built": "node scripts/verify-built.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "measure:build": "node scripts/measure-build.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "26.1.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "4.1.12"
  }
