# TEMPLATE ONLY. Replace all __...__ tokens after domain/certificate approval.
# Install in the http context, for example /etc/nginx/conf.d/daneva.conf.
# Supported baseline: Nginx 1.24+; no newer header-inheritance directive required.
log_format daneva_safe '$time_iso8601 $status $request_method $body_bytes_sent $request_time';
server {
    listen 80;
    server_name __APPROVED_HOST__;
    access_log /var/log/nginx/daneva-access.log daneva_safe;
    error_log /var/log/nginx/daneva-error.log crit;
    # Run the certificate-provider HTTP challenge using its documented temporary config.
    # Enable this redirect only after the HTTPS server below is verified.
    return 308 https://__APPROVED_HOST__$request_uri;
}
server {
    listen 443 ssl;
    server_name __APPROVED_HOST__;
    ssl_certificate __CERTIFICATE_CHAIN_PATH__;
    ssl_certificate_key __CERTIFICATE_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /srv/daneva/current/dist;
    index index.html;
    autoindex off;
    access_log /var/log/nginx/daneva-access.log daneva_safe;
    # Error logs can include request URLs; protect and retain briefly, never enable debug.
    error_log /var/log/nginx/daneva-error.log crit;
    include /srv/daneva/current/dist/security-headers.conf;
    # ONLY after HTTPS and all relevant hosts are verified:
    # add_header Strict-Transport-Security "max-age=31536000" always;
    # Do not add includeSubDomains/preload without a separate domain-wide decision.
    client_max_body_size 32k;
    client_body_timeout 15s;
    send_timeout 20s;
    keepalive_timeout 20s;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json application/xml image/svg+xml;

    location ~ /\. { return 404; }
    location = /build-info.json { return 404; }
    location ~ ^/security-headers\. { return 404; }
    location /assets/ { try_files $uri =404; expires 1y; }
    location ~ ^/(brand|fonts|social)/ { try_files $uri =404; expires 7d; }
    # Match the canonical route shape rather than redirect to directory URLs.
    location ~ ^/(about|services|transport-corridors|fleet-operations|safety-compliance|contact|request-quote)/$ { return 308 /$1; }
    error_page 404 /404.html;
    location = /404.html { internal; expires -1; }
    location / { try_files $uri/index.html $uri =404; expires -1; }
}
